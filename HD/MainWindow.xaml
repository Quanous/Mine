<Window x:Class="HD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HD" Width="480" Height="800" MinWidth="430" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">

  <Window.Resources>
    <!-- 목록 한 줄 -->
    <DataTemplate x:Key="RowTemplate">
      <Border Style="{StaticResource CardStyle}" Padding="14,13" Margin="0,0,0,10" Cursor="Hand">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Width="54" Height="54" Margin="0,0,14,0">
            <Ellipse>
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#E60012" Offset="0"/>
                  <GradientStop Color="#4A0008" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding Initial, Mode=OneWay}" Visibility="{Binding InitialVisibility}"
                       FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Visibility="{Binding AvatarVisibility}">
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Stroke="#2EFFFFFF" StrokeThickness="1"/>
          </Grid>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding DateText, Mode=OneWay}" FontSize="12.5" Margin="0,3,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,2,0">
            <TextBlock FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="28"
                       TextAlignment="Right" Foreground="{Binding NumBrush}">
              <Run Text="{Binding Prefix, Mode=OneWay}" FontSize="16"/><Run Text="{Binding Number, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding Remain, Mode=OneWay}" FontSize="11.5" TextAlignment="Right"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">

    <!-- 그림자 -->
    <Border Margin="18" CornerRadius="22" Background="#000000" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
      </Border.Effect>
    </Border>

    <!-- 앱 본체 -->
    <Border x:Name="Shell" Margin="18" CornerRadius="22"
            Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <Grid x:Name="Stage">
        <Grid.RowDefinitions>
          <RowDefinition Height="66"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 은은한 붉은 빛 -->
        <Border Grid.RowSpan="2" CornerRadius="22" IsHitTestVisible="False">
          <Border.Background>
            <RadialGradientBrush Center="0.12,-0.04" GradientOrigin="0.12,-0.04" RadiusX="0.95" RadiusY="0.5">
              <GradientStop Color="#40E60012" Offset="0"/>
              <GradientStop Color="#00E60012" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>

        <!-- 제목줄 -->
        <Grid x:Name="TitleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False">
            <Border x:Name="LogoBox" Width="32" Height="32" CornerRadius="10"
                    BorderBrush="#40FFFFFF" BorderThickness="1"/>
            <TextBlock Text="HD" Margin="12,0,0,1" FontFamily="{StaticResource NumFont}"
                       FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock Text="D-DAY" Margin="9,4,0,0" FontSize="11" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
            <Button x:Name="BtnPin" Style="{StaticResource IconBtn}">
              <Path Width="17" Height="17" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M16,9V4l1,0c0.55,0,1-0.45,1-1v0c0-0.55-0.45-1-1-1H7C6.45,2,6,2.45,6,3v0c0,0.55,0.45,1,1,1l1,0v5c0,1.66-1.34,3-3,3h0v2h5.97v7l1,1l1-1v-7H19v-2h0C17.34,12,16,10.66,16,9z"/>
            </Button>
            <Button x:Name="BtnAdd" Style="{StaticResource IconBtn}">
              <Path Width="18" Height="18" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </Button>
            <Button x:Name="BtnMin" Style="{StaticResource IconBtn}">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M6 19h12v2H6z"/>
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 본문 -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Background="Transparent"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="22,2,22,24">

            <!-- 히어로 카드 (가장 가까운 디데이) -->
            <Grid x:Name="HeroHost" Margin="0,4,0,24">
              <Border x:Name="HeroBg" CornerRadius="24" Background="#1B1B20"/>
              <Border CornerRadius="24">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#F20B0B0E" Offset="0"/>
                    <GradientStop Color="#A00B0B0E" Offset="0.55"/>
                    <GradientStop Color="#26000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border CornerRadius="24">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00000000" Offset="0.3"/>
                    <GradientStop Color="#B8000000" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border CornerRadius="24" BorderBrush="#30FFFFFF" BorderThickness="1"/>

              <Grid Margin="26,22,26,22" MinHeight="200">
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12"
                        Background="#70000000" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="11,5">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,1,8,0"/>
                    <TextBlock x:Name="HeroChip" Text="다가오는 디데이" FontSize="12" FontWeight="SemiBold" Foreground="#E2E2E9"/>
                  </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Bottom">
                  <TextBlock x:Name="HeroName" FontSize="22" FontWeight="SemiBold" Foreground="White"
                             TextTrimming="CharacterEllipsis" Margin="0,0,0,0">
                    <TextBlock.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                    </TextBlock.Effect>
                  </TextBlock>
                  <TextBlock x:Name="HeroNumber" FontFamily="{StaticResource NumFont}" FontWeight="Bold"
                             Foreground="{StaticResource AccentBrush}" Margin="0,-4,0,0">
                    <TextBlock.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="#000000"/>
                    </TextBlock.Effect>
                    <Run x:Name="HeroPrefix" FontSize="32"/><Run x:Name="HeroNum" FontSize="90"/>
                  </TextBlock>
                  <TextBlock x:Name="HeroDate" FontSize="13.5" Foreground="#CFCFD8" Margin="0,-2,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>

            <StackPanel x:Name="UpcomingPanel">
              <TextBlock x:Name="UpcomingLabel" Style="{StaticResource SectionLabel}" Text="다가오는 일정"/>
              <ItemsControl x:Name="UpcomingList" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Focusable="False"/>
            </StackPanel>

            <StackPanel x:Name="PastPanel" Margin="0,10,0,0">
              <TextBlock x:Name="PastLabel" Style="{StaticResource SectionLabel}" Text="지난 일정"/>
              <ItemsControl x:Name="PastList" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Focusable="False"/>
            </StackPanel>

            <!-- 비어 있을 때 -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,56,0,0">
              <Grid Width="136" Height="136" HorizontalAlignment="Center">
                <Ellipse x:Name="EmptyArt" Fill="#1B1B20"/>
                <Ellipse Stroke="#55E60012" StrokeThickness="2"/>
              </Grid>
              <TextBlock Text="아직 디데이가 없어요" FontSize="21" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" Margin="0,26,0,0"/>
              <TextBlock Text="기념일, 시험, 여행 날짜를 추가해 보세요" FontSize="13.5"
                         Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
              <Button x:Name="EmptyAddBtn" Content="+  디데이 추가" Style="{StaticResource PrimaryBtn}"
                      Width="190" Margin="0,28,0,0"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ================= 추가 / 수정 시트 ================= -->
        <Grid x:Name="SheetLayer" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="SheetBackdrop" Background="#CC000000" CornerRadius="22"/>
          <Border x:Name="SheetCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="#1B1B21" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="22" Padding="24,22,24,24">
            <Border.Effect>
              <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform x:Name="SheetShift" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Width="312">
              <TextBlock x:Name="SheetTitle" Text="디데이 추가" FontSize="20" FontWeight="Bold" Foreground="White"/>

              <Grid x:Name="PicBox" Width="108" Height="108" Margin="0,20,0,0" HorizontalAlignment="Center"
                    Cursor="Hand" AllowDrop="True" Background="Transparent">
                <Ellipse Fill="#1FFFFFFF"/>
                <Path x:Name="PicHint" Width="34" Height="34" Stretch="Uniform" Fill="#7A7A86"
                      Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                <Ellipse x:Name="PicImage" Visibility="Collapsed"/>
                <Ellipse x:Name="PicRing" Stroke="#55FFFFFF" StrokeThickness="1.5" StrokeDashArray="3 3"/>
                <Border x:Name="PicBadge" Width="32" Height="32" CornerRadius="16" Background="#E60012"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"
                        BorderBrush="#1B1B21" BorderThickness="3">
                  <Path Width="13" Height="13" Stretch="Uniform" Fill="White"
                        Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                </Border>
              </Grid>
              <TextBlock x:Name="PicCaption" Text="사진 선택 (클릭하거나 끌어다 놓기)" FontSize="12" Foreground="#7A7A86"
                         HorizontalAlignment="Center" Margin="0,10,0,0"/>
              <Button x:Name="BtnRemovePic" Content="사진 제거" Style="{StaticResource LinkBtn}"
                      HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>

              <TextBlock Text="이름" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="40"/>

              <TextBlock Text="날짜" Style="{StaticResource FieldLabel}"/>
              <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <TextBox x:Name="YearBox" Style="{StaticResource FieldCenter}" Width="74" MaxLength="4"/>
                  <TextBlock Text="년" Style="{StaticResource Unit}"/>
                  <TextBox x:Name="MonthBox" Style="{StaticResource FieldCenter}" Width="50" MaxLength="2"/>
                  <TextBlock Text="월" Style="{StaticResource Unit}"/>
                  <TextBox x:Name="DayBox" Style="{StaticResource FieldCenter}" Width="50" MaxLength="2"/>
                  <TextBlock Text="일" Style="{StaticResource Unit}" Margin="7,0,0,0"/>
                </StackPanel>
                <Button x:Name="BtnToday" Content="오늘" Style="{StaticResource GhostBtn}" Width="56" Height="42"
                        FontSize="13" HorizontalAlignment="Right"/>
              </Grid>

              <Border x:Name="PreviewBox" CornerRadius="12" Background="#12FFFFFF" Padding="14,11" Margin="0,14,0,0">
                <TextBlock x:Name="PreviewText" FontSize="14" FontWeight="SemiBold" Foreground="#8E8E99"/>
              </Border>

              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCancel" Content="취소" Style="{StaticResource GhostBtn}"/>
                <Button x:Name="BtnSave" Grid.Column="2" Content="추가" Style="{StaticResource PrimaryBtn}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ================= 삭제 확인 ================= -->
        <Grid x:Name="ConfirmLayer" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="ConfirmBackdrop" Background="#CC000000" CornerRadius="22"/>
          <Border x:Name="ConfirmCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="#1B1B21" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="22" Padding="24,24,24,22">
            <Border.Effect>
              <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform x:Name="ConfirmShift" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Width="280">
              <TextBlock Text="삭제할까요?" FontSize="20" FontWeight="Bold" Foreground="White"/>
              <TextBlock x:Name="ConfirmMsg" FontSize="14" Foreground="#A4A4AF" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ConfirmCancel" Content="취소" Style="{StaticResource GhostBtn}"/>
                <Button x:Name="ConfirmOk" Grid.Column="2" Content="삭제" Style="{StaticResource PrimaryBtn}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ================= 우클릭 메뉴 ================= -->
        <Grid x:Name="MenuLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
          <Border x:Name="MenuCard" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="200"
                  Background="#202026" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14" Padding="6">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <StackPanel x:Name="MenuItems"/>
          </Border>
        </Grid>

      </Grid>
    </Border>

    <!-- 창 크기 조절 손잡이 (눈에 안 보임) -->
    <Rectangle x:Name="RL" Tag="1" Fill="Transparent" HorizontalAlignment="Left" Width="10" Margin="13,34,0,34" Cursor="SizeWE"/>
    <Rectangle x:Name="RR" Tag="2" Fill="Transparent" HorizontalAlignment="Right" Width="10" Margin="0,34,13,34" Cursor="SizeWE"/>
    <Rectangle x:Name="RT" Tag="3" Fill="Transparent" VerticalAlignment="Top" Height="10" Margin="34,13,76,0" Cursor="SizeNS"/>
    <Rectangle x:Name="RB" Tag="6" Fill="Transparent" VerticalAlignment="Bottom" Height="10" Margin="34,0,34,13" Cursor="SizeNS"/>
    <Rectangle x:Name="RTL" Tag="4" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Width="20" Height="20" Margin="12,12,0,0" Cursor="SizeNWSE"/>
    <Rectangle x:Name="RTR" Tag="5" Fill="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Margin="0,12,12,0" Cursor="SizeNESW"/>
    <Rectangle x:Name="RBL" Tag="7" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="20" Height="20" Margin="12,0,0,12" Cursor="SizeNESW"/>
    <Rectangle x:Name="RBR" Tag="8" Fill="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Margin="0,0,12,12" Cursor="SizeNWSE"/>
  </Grid>
</Window>
